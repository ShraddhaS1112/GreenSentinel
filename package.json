{
  "name": "green-sentinel",
  "version": "1.0.0",
  "description": "Digital Immune System for Indian Agriculture - Satellite + AI Vision threat detection",
  "private": true,
  "workspaces": [
    "packages/*",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend && npm run build --workspace=@green-sentinel/backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=@green-sentinel/backend",
    "deploy": "npm run deploy --workspace=@green-sentinel/infrastructure",
    "deploy:frontend": "npm run deploy --workspace=frontend",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/green-sentinel/green-sentinel.git"
  },
  "keywords": [
    "agriculture",
    "ai",
    "threat-detection",
    "satellite",
    "ndvi",
    "pwa",
    "serverless",
    "aws"
  ],
  "author": "Green Sentinel Team",
  "license": "MIT"
}
