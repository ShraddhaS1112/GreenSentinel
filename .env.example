# Green Sentinel - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# AWS Configuration
# =============================================================================
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=your-aws-account-id

# =============================================================================
# Sentinel Hub (Satellite Data)
# Register at: https://www.sentinel-hub.com/
# =============================================================================
SENTINEL_HUB_CLIENT_ID=your-client-id
SENTINEL_HUB_CLIENT_SECRET=your-client-secret

# =============================================================================
# Twilio (WhatsApp Notifications)
# Register at: https://www.twilio.com/
# =============================================================================
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_NUMBER=+14155238886

# =============================================================================
# Bhashini (Translation & Voice)
# Register at: https://bhashini.gov.in/ulca
# =============================================================================
BHASHINI_USER_ID=your-user-id
BHASHINI_ULCA_API_KEY=your-ulca-api-key
BHASHINI_INFERENCE_API_KEY=your-inference-api-key
BHASHINI_PIPELINE_ID=your-pipeline-id

# =============================================================================
# Frontend Configuration
# =============================================================================
VITE_API_URL=https://api.your-domain.com
VITE_WS_URL=wss://api.your-domain.com/realtime

# =============================================================================
# Development Settings
# =============================================================================
NODE_ENV=development
DEBUG=false
