# ============================================================
# GreenSentinel Backend – Environment Variables Template
# Copy this file to .env and fill in your own values.
# ⚠️  NEVER commit the actual .env file to source control!
# ============================================================

# ---- Twilio Credentials ----
# Get these from https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# ---- Twilio Phone Numbers ----
# Your Twilio purchased number for SMS
TWILIO_PHONE_NUMBER=+1234567890
# Twilio WhatsApp sandbox number (or your approved WhatsApp sender)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ---- Default Alert Recipient ----
# Farmer's WhatsApp number to receive threat alerts
TWILIO_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX
