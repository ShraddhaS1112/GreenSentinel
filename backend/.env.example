# ============================================================
# GreenSentinel Backend – Environment Variables Template
# Copy this file to .env and fill in your own values.
# ⚠️  NEVER commit the actual .env file to source control!
# ============================================================

# ---- Twilio Credentials ----
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=${TWILIO_ACCOUNT_SID}
TWILIO_AUTH_TOKEN=your_auth_token_here

# ---- Twilio Phone Numbers ----
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886   # Twilio sandbox number (or your approved number)

# ---- WhatsApp Recipient ----
TWILIO_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX       # Developer / tester's WhatsApp number
