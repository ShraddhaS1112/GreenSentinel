# ============================================================
# GreenSentinel Frontend – Environment Variables Template
# Copy this file to .env.local and fill in your values.
# ⚠️  NEVER commit the actual .env.local file to source control!
# ============================================================

# ---- Backend API URL ----
VITE_BACKEND_API_URL=http://localhost:3001

# ---- Alert Settings ----
# Enable/disable WhatsApp alerts (true/false)
VITE_ENABLE_WHATSAPP_ALERTS=true
# Minimum confidence % to trigger an alert (0-100)
VITE_ALERT_CONFIDENCE_THRESHOLD=75
# Cooldown in seconds between repeated alerts of same type
VITE_ALERT_COOLDOWN_SECONDS=300
# Farmer's WhatsApp number to receive alerts
VITE_ALERT_PHONE_NUMBER=+91XXXXXXXXXX

# ---- Twilio Credentials (used by twilioService.ts) ----
# Get from https://console.twilio.com
VITE_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_TWILIO_AUTH_TOKEN=your_auth_token_here
# Twilio WhatsApp sender (sandbox or approved number)
VITE_TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Default recipient WhatsApp number
VITE_TWILIO_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX
