# Green Sentinel Frontend - Environment Configuration
# Copy this file to .env and fill in your values

# API Configuration
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/realtime

# AWS Amplify Configuration (for production)
VITE_AWS_REGION=ap-south-1
VITE_AWS_USER_POOL_ID=ap-south-1_XXXXXXXX
VITE_AWS_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_AWS_APPSYNC_URL=https://xxxxxxxxxx.appsync-api.ap-south-1.amazonaws.com/graphql
VITE_AWS_APPSYNC_REGION=ap-south-1

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_MOCK_DATA=true

# Debug
VITE_DEBUG=false
