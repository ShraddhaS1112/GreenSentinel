# Green Sentinel Frontend - Environment Configuration
# Copy this file to .env and fill in your values

# API Configuration
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/realtime

# AWS Cognito Configuration (for phone+OTP authentication)
# Get these from CDK deployment output or AWS Console
VITE_AWS_REGION=ap-south-1
VITE_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_MOCK_DATA=true

# Debug
VITE_DEBUG=false
